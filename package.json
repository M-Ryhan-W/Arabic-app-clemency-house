{
  "name": "language-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:android": "CAPACITOR_BUILD=1 vite build",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug-apk": "npm run build:android && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release-apk": "npm run build:android && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:release-bundle": "npm run build:android && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@emotion/is-prop-valid": "^1.4.0",
    "@iconify/react": "^6.0.2",
    "@independo/capacitor-voice-recorder": "^8.1.0",
    "@lottiefiles/dotlottie-react": "^0.17.12",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/vite": "^4.2.1",
    "ldrs": "^1.1.9",
    "motion": "^12.27.5",
    "ogl": "^1.0.11",
    "puppeteer": "^24.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "vite": "^7.2.4"
  }
}
